{
  "ConnectionStrings": {
    "BlackoutWatch": "Data Source=/data/blackoutwatch.db"
  },
  "BlackoutWatch": {
    "HeartbeatCron": "*/5 * * * * *",
    "HeartbeatRestartDelay": "00:00:05",
    "NotificationRetryInitialDelay": "00:00:05",
    "NotificationRetryMaxDelay": "00:05:00",
    "NotificationMaxAttempts": 10,
    "MinimumOutageSeconds": 60,
    "Webhook": {
      "Enabled": false,
      "Url": null
    },
    "Mqtt": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 1883,
      "UseTls": false,
      "Username": null,
      "Password": null,
      "Topic": "blackoutwatch/events"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
